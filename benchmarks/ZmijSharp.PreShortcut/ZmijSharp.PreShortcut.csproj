<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>ZmijSharp.PreShortcut</AssemblyName>
    <DefineConstants>$(DefineConstants);ZMIJ_NO_INTEGER_SHORTCUT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/ZmijSharp/ZmijCore.cs" Link="ZmijCore.cs" />
    <Compile Include="../../src/ZmijSharp/ZmijDecimal.cs" Link="ZmijDecimal.cs" />
    <Compile Include="../../src/ZmijSharp/CompactPow10Cache.cs" Link="CompactPow10Cache.cs" />
    <InternalsVisibleTo Include="ZmijSharp.Benchmarks" />
    <InternalsVisibleTo Include="ZmijSharp.Verify" />
  </ItemGroup>
</Project>
